{
  "compilerOptions": {
    "jsx": "react",
    "sourceMap": true,
    "moduleResolution": "bundler",
    "target": "ES2020",
    "allowSyntheticDefaultImports": true,
    "noErrorTruncation": true,
    "strict": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"],
  "exclude": ["./src/entry.ts", "./*.js", "./*.d.ts", "./.yalc/**"],
  "references": [
    {
      "path": "../../libs/ui-lib"
    }
  ]
}
